# Скопируйте в .env на сервере (в папку проекта) и заполните. В git .env не попадает.

# ИИ-помощник. Ключ шлюза novpnai (gw-…) или OpenRouter (sk-or-…).
OPENROUTER_API_KEY=
# Адрес OpenAI-совместимого /chat/completions. По умолчанию — шлюз novpnai (доступен из РФ).
# OIL_LLM_URL=https://openrouter.ai/api/v1/chat/completions
# Модель агента. По умолчанию google/gemini-2.5-flash: быстро, дёшево, хорошо держит JSON.
# OIL_AGENT_MODEL=google/gemini-2.5-flash

# Ключ подписи токенов входа (любая длинная случайная строка). Если пусто — генерируется и
# хранится в базе.
OIL_SECRET_KEY=

# Первый администратор — создаётся ОДИН раз, когда таблица пользователей пуста.
# Потом пароль меняется в интерфейсе: Управление → Пользователи → Мой пароль.
OIL_ADMIN_USER=oilpress
OIL_ADMIN_PASSWORD=

# Пароли MySQL. Меняются только на новой базе (или вручную через ALTER USER на старой).
# DB_PASSWORD=
# DB_ROOT_PASSWORD=
